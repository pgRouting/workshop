msgid ""
"**File location**: Choose a suitable location for the Virtual Hard Disk"
msgstr "**File location**: 仮想ハードディスクの適切な保存場所を選びます"

#: ../../build/docs/general-intro/osgeolive.rst:105
msgid "**File size**: 10.0GB"
msgstr "**File size**: 10.0GB"

#: ../../build/docs/general-intro/osgeolive.rst:106
msgid "**Hard disk file type**: VDI (VirtualBox Disk image)"
msgstr "**Hard disk file type**: VDI (VirtualBox Disk image)"

#: ../../build/docs/general-intro/osgeolive.rst:107
msgid "**Storage on physical hard disk**: Dynamically allocated"
msgstr "**Storage on physical hard disk**: Dynamically allocated"

#: ../../build/docs/general-intro/osgeolive.rst:112
msgid "Install OSGeoLive's ISO"
msgstr "OSGeoLive の ISO のインストール"

#: ../../build/docs/general-intro/osgeolive.rst:114
msgid "On Storage it reads:"
msgstr "Storage には次のように表示されています:"

#: ../../build/docs/general-intro/osgeolive.rst
msgid "Controller"
msgstr "Controller"

#: ../../build/docs/general-intro/osgeolive.rst:116
