msgstr "人権の保護"

#: ../../build/docs/un_sdg/introduction.rst:54
msgid "Deliver Humanitarian Aid"
msgstr "人道支援の提供"

#: ../../build/docs/un_sdg/introduction.rst:55
msgid "Support Sustainable Development and Climate Action"
msgstr "持続可能な開発と気候変動対策の支援"

#: ../../build/docs/un_sdg/introduction.rst:56
msgid "Uphold International Law"
msgstr "国際法の擁護"

#: ../../build/docs/un_sdg/introduction.rst:59
msgid "What are the Sustainable Development Goals?"
msgstr "持続可能な開発目標とは"

#: ../../build/docs/un_sdg/introduction.rst:63
